# Copy to .env (git-ignored) and replace placeholders before any real use.
# Free-tier, Rs 0 development stack only. Never commit real values.

# Required: development | test | production
APP_ENV=development

# Optional: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Offline stub is the default; groq/gemini require a matching free-tier key.
AI_PROVIDER=stub

# Supabase Free development project. Backend only; never expose the service role to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY

# Groq / Gemini free-tier keys, needed only when AI_PROVIDER selects that provider.
GROQ_API_KEY=REPLACE_ME_GROQ_API_KEY
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
